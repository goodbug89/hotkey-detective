<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>inventory.summary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@r@ · %2$#@c@</string>
		<key>c</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>Конфликтов: %ld</string>
		</dict>
		<key>r</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>other</key>
			<string>Зарегистрировано: %ld</string>
		</dict>
	</dict>
	<key>signal.newWindows</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>открыто %ld новых окна</string>
			<key>many</key>
			<string>открыто %ld новых окон</string>
			<key>one</key>
			<string>открыто %ld новое окно</string>
			<key>other</key>
			<string>открыто %ld новых окна</string>
		</dict>
	</dict>
	<key>verdict.evidenceCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>few</key>
			<string>%ld свидетельства</string>
			<key>many</key>
			<string>%ld свидетельств</string>
			<key>one</key>
			<string>%ld свидетельство</string>
			<key>other</key>
			<string>%ld свидетельства</string>
		</dict>
	</dict>
</dict>
</plist>
